# Test environment - values are not used in unit tests (services are mocked)
# Required so the container can resolve env vars

KERNEL_CLASS=App\Kernel
APP_ENV=test
APP_SECRET='$ecretf0rt3st'

# Use null mailer - no emails sent during tests
MAILER_DSN=null://null

# Dummy values - Twilio/Mailer/Google are never called in tests
FIREBASE_CREDENTIALS=config/secrets/firebase_credentials.json
TWILIO_ACCOUNT_SID=ACtest
TWILIO_AUTH_TOKEN=test
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_SMS_FROM=+1234567890
GEMINI_API_KEY=test
GEMINI_MODEL=gemini-2.5-flash

STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_test_dummy
STRIPE_PRICE_SOLVER=price_dummy
STRIPE_PRICE_PRO=price_dummy

NOTIFICATIONS_PRO=PUSH
NOTIFICATIONS_SOLVER=PUSH
NOTIFICATIONS_FREE=EMAIL
NOTIFICATIONS_CLIENT=PUSH

# Test database: con APP_ENV=test Doctrine añade sufijo _test al nombre (p. ej. quira_db → quira_db_test).
# Arranca MySQL: docker compose up -d database
# Luego: APP_ENV=test php bin/console doctrine:database:create --if-not-exists && php bin/console doctrine:migrations:migrate --no-interaction
DATABASE_URL="mysql://root:root@127.0.0.1:3306/quira_db?serverVersion=8.0&charset=utf8mb4"
