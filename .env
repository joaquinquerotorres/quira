# In all environments, the following files are loaded in order:
#  .env                - default values (committed)
#  .env.local          - local overrides and secrets (gitignored)
#  .env.$APP_ENV       - environment-specific defaults
#  .env.$APP_ENV.local - environment-specific overrides
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE.
# Copy .env.local.example to .env.local and fill in your values.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Override in .env.local with your local DB credentials
DATABASE_URL="mysql://root:root@127.0.0.1:3306/quira_db?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Brevo (symfony/brevo-mailer): panel → SMTP & API → crea API key y/o SMTP key + login.
#
# Recomendado — API HTTP (clave en el DSN; codifica @ : / si hace falta con rawurlencode):
#   MAILER_DSN=brevo+api://xkeysib_...@default
# Alternativa — SMTP vía bridge Brevo:
#   MAILER_DSN=brevo+smtp://SMTP_LOGIN:SMTP_KEY@default
# Sin Brevo — SMTP genérico mismo servidor:
#   MAILER_DSN=smtp://LOGIN:KEY@smtp-relay.brevo.com:587
#
# Local: null://null (no envía) | MailHog: smtp://127.0.0.1:1025
# Railway: define MAILER_DSN en Variables. El remitente no-reply@quira.app debe estar verificado en Brevo.
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> sentry/sentry-symfony ###
# DSN del proyecto en https://sentry.io (solo producción o staging; vacío = desactivado)
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> app ###
# URL del frontend para enlaces (verificar email y recuperar contraseña)
FRONTEND_URL=http://localhost:8100

# Assets públicos Supabase (bucket quira):
#   Logo correos: https://jeofdevvotlovkjfbizv.supabase.co/storage/v1/object/public/quira/quira_logo.png
#   Ilustración requests (app): https://jeofdevvotlovkjfbizv.supabase.co/storage/v1/object/public/quira/quira_requests.png
# EMAIL_LOGO_URL vacío → usa quira_logo (config/services.yaml env_default_email_logo_url).
EMAIL_LOGO_URL=

# Path to Firebase service account JSON (Auth, notificaciones - NO para media)
FIREBASE_CREDENTIALS=config/secrets/firebase_credentials.json

# Twilio (SMS/WhatsApp) - get from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Canal por audiencia: PUSH | EMAIL | WHATSAPP (cambiable sin código). Twilio solo se usa si el valor es WHATSAPP.
NOTIFICATIONS_PRO=PUSH
NOTIFICATIONS_SOLVER=PUSH
NOTIFICATIONS_FREE=EMAIL
NOTIFICATIONS_CLIENT=PUSH

# Gemini API - https://ai.google.dev
GEMINI_API_KEY=
# Modelo Gemini (ej: gemini-2.5-flash o models/gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Stripe - suscripciones SOLVER (4,99€/mes) y PRO (12,99€/mes)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLVER=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Supabase Storage - para tickets de subida (avatars, media de requests)
# Settings > API en el panel de Supabase. ¡NUNCA en el frontend!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nombres de los buckets (deben coincidir exactamente con los de Supabase)
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_REQUESTS=requests
###< app ###
