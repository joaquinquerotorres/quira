# Copy this file to .env.local and fill in your values.
# .env.local is gitignored - never commit real secrets.

###> symfony/framework-bundle ###
APP_SECRET=your_32_char_secret_here
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://user:password@127.0.0.1:3306/quira_db?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# null://null - descarta correos
# smtp://localhost:1025 - MailHog local (docker compose up -d mailhog, ver en http://localhost:8025)
# smtp://user:pass@smtp.example.com:587 - envío real
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
# Generate: openssl genpkey -out config/jwt/private.pem -aes256 -algorithm rsa -pkeyopt rsa_keygen_bits:4096
# Then create public.pem and set passphrase
JWT_PASSPHRASE=your_jwt_passphrase
###< lexik/jwt-authentication-bundle ###

###> app ###
APP_URL=https://api.quira.app
# URL del frontend para enlaces de recuperación de contraseña
FRONTEND_URL=https://app.quira.app

FIREBASE_CREDENTIALS=config/secrets/firebase_credentials.json

TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_SMS_FROM=+1234567890

GEMINI_API_KEY=your_gemini_api_key

# Supabase Storage - tickets de subida (avatar, media de requests)
# URL del proyecto (Settings > API). service_role key: ¡solo en backend, nunca en frontend!
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Nombres exactos de los buckets en Supabase Storage
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_REQUESTS=requests
###< app ###
